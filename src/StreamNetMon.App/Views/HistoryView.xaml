<UserControl x:Class="StreamNetMon.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StreamNetMon.App.Controls">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <ComboBox x:Name="DeviceBox" Width="200" DisplayMemberPath="Name" SelectionChanged="Changed" Margin="0,0,8,0" />
            <ComboBox x:Name="RangeBox" Width="110" SelectedIndex="0" SelectionChanged="Changed" Margin="0,0,8,0">
                <ComboBoxItem Content="1 hour" />
                <ComboBoxItem Content="6 hours" />
                <ComboBoxItem Content="24 hours" />
                <ComboBoxItem Content="7 days" />
            </ComboBox>
            <Button Content="◀ Earlier" Click="Earlier_Click" Padding="8,2" Margin="0,0,4,0" />
            <Button x:Name="LaterButton" Content="Later ▶" Click="Later_Click" Padding="8,2" Margin="0,0,4,0" />
            <Button Content="Now" Click="Now_Click" Padding="8,2" Margin="0,0,10,0" />
            <TextBlock x:Name="RangeText" VerticalAlignment="Center" Foreground="#5F666D" />
        </StackPanel>
        <c:TimeChart x:Name="LatencyChart" Grid.Row="1" Title="Latency (worst in each interval)" Unit="Milliseconds" MinimumTop="2" Margin="0,0,0,6" />
        <c:TimeChart x:Name="JitterChart" Grid.Row="2" Title="Jitter" Unit="Milliseconds" MinimumTop="2" Margin="0,0,0,6" />
        <c:TimeChart x:Name="LossChart" Grid.Row="3" Title="Packet loss" Unit="Percent" MinimumTop="2" Margin="0,0,0,6" />
        <c:TimeChart x:Name="SendChart" Grid.Row="4" Title="Sent by this PC" Unit="Rate" MinimumTop="1000000" />
    </Grid>
</UserControl>
