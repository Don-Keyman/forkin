<Window x:Class="StreamNetMon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:StreamNetMon.App.Views"
        Title="Stream network monitor" Width="760" Height="560" MinWidth="620" MinHeight="420"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <TabControl x:Name="Tabs" TabStripPlacement="Bottom" BorderThickness="0">
        <TabItem Header="Live">
            <v:LiveView x:Name="Live" />
        </TabItem>
    </TabControl>
</Window>
